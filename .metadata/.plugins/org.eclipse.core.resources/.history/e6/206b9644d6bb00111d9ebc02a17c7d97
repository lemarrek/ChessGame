package model;

public class Case {
	private final String ligne;
	private final int colonne;
	private Piece piece;
	private Couleur couleur;
	
	public Case(String l, int c, Piece p, Couleur color) {
		this.ligne=l;
		this.colonne=c;
		this.piece=p;
		this.couleur=color;
	}
	
	public void setPiece(Piece p) {
		this.piece=p;
	}
	
	public Piece getPiece() {
		return this.piece;
	}
}
